{
  "name": "visual-ai-agent-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ingestion API + dashboard for the Visual AI Agent. Writes browser-activity batches to NeonDB (Postgres).",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "migrate": "node --env-file=.env scripts/migrate.js",
    "seed": "node --env-file=.env scripts/seed.js",
    "test:ingest": "node --env-file=.env scripts/test-ingest.js",
    "caption": "node --env-file=.env scripts/caption.js",
    "analyze": "node --env-file=.env scripts/analyze.js",
    "embed": "node --env-file=.env scripts/embed.js",
    "index": "node --env-file=.env scripts/index.js",
    "demo": "npm run migrate && npm run seed && next dev -p 3100"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@clerk/nextjs": "^7.6.4",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "next": "^15.1.6",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "engines": {
    "node": ">=20 <25"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.19"
  }
}
