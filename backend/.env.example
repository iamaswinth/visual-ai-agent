# Copy to .env and fill in your Neon connection string.
#
# Neon: create a project at https://neon.tech, then copy the "Pooled connection"
# string from the dashboard. It looks like:
#   postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
#
# For local testing with Docker Postgres (see backend/README.md):
#   postgresql://postgres:postgres@localhost:5434/visual_ai_agent

DATABASE_URL=

# Shared secret the extension must send (x-ingest-token) to POST /api/ingest.
# Set the SAME value in the extension's config.js. Leave empty for local dev.
INGEST_TOKEN=

# AI features — screenshot captions, session summaries, and the agent chat.
# Without ANTHROPIC_API_KEY the app still runs; those buttons/chat report that
# no key is set. Get one at https://console.anthropic.com.
ANTHROPIC_API_KEY=
CAPTION_MODEL=claude-haiku-4-5      # cheap/fast, per-screenshot captions
REASONING_MODEL=claude-sonnet-5     # session summaries + chat answers

# Vector RAG for the agent chat — embeddings (Anthropic has no embeddings API).
# Without OPENAI_API_KEY, chat falls back to recent-sessions context (no vector
# search). Requires the pgvector Postgres extension (Neon has it; local dev must
# use the pgvector/pgvector:pg16 image).
OPENAI_API_KEY=
EMBED_MODEL=text-embedding-3-small
# RAG_TOP_K=5
# RAG_MIN_SCORE=0.15

# Clerk auth — gates the dashboard. Get keys at https://dashboard.clerk.com
# (API keys). Required for the app to run once auth is enabled.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
