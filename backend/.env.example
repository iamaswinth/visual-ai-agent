# Copy to .env and fill in your Neon connection string.
#
# Neon: create a project at https://neon.tech, then copy the "Pooled connection"
# string from the dashboard. It looks like:
#   postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
#
# For local testing with Docker Postgres (see backend/README.md):
#   postgresql://postgres:postgres@localhost:5434/visual_ai_agent

DATABASE_URL=

# Optional — enables the "Visual AI" captioning of screenshots.
# Without a key the app still runs; the "Generate captions" button just reports
# that no key is set. Get one at https://console.anthropic.com.
ANTHROPIC_API_KEY=
# Vision model used for captions (defaults to claude-opus-5).
CAPTION_MODEL=claude-opus-5

# Clerk auth — gates the dashboard. Get keys at https://dashboard.clerk.com
# (API keys). Required for the app to run once auth is enabled.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
