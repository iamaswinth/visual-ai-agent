# Copy to .env and fill in your Neon connection string.
#
# Neon: create a project at https://neon.tech, then copy the "Pooled connection"
# string from the dashboard. It looks like:
#   postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
#
# For local testing with Docker Postgres (see backend/README.md):
#   postgresql://postgres:postgres@localhost:5433/visual_ai_agent

